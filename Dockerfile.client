# GAFLEX web client: builds the Vite app, serves it as a static SPA with nginx.
# VITE_SERVER_URL is baked in at build time (pass it as a build argument / Coolify build variable).
FROM node:20-alpine AS build
WORKDIR /repo
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/client/package.json apps/client/
# the lockfile lists every workspace project; its manifest keeps --frozen-lockfile happy
COPY apps/server/package.json apps/server/
RUN pnpm install --frozen-lockfile --filter @gaflex/client...
COPY packages/shared packages/shared
COPY apps/client apps/client
ARG VITE_SERVER_URL
RUN test -n "$VITE_SERVER_URL" || (echo "VITE_SERVER_URL build argument is required" && exit 1)
ENV VITE_SERVER_URL=$VITE_SERVER_URL
RUN pnpm --filter @gaflex/client build

FROM nginx:1.27-alpine
COPY deploy/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/client/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost/ >/dev/null || exit 1
